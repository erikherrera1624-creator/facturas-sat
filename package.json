{
  "name": "facturas-sat",
  "productName": "Facturas SAT",
  "version": "1.0.0",
  "description": "Descarga masiva de facturas (CFDI) emitidas y recibidas del SAT, con PDF y Excel.",
  "main": "main.js",
  "author": "Facturas SAT",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.facturassat.app",
    "productName": "Facturas SAT",
    "artifactName": "FacturasSAT-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "build-info.json",
      "src/**/*",
      "renderer/**/*",
      "remote/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Facturas SAT"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
